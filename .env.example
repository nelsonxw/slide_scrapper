# Firebase Storage Configuration
FIREBASE_STORAGE_BUCKET=slide-preview.firebasestorage.app
# Path to your Firebase Service Account JSON credentials file (relative to backend or absolute)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# Set to true to enable SSL verification (may fail behind corporate proxies)
FIREBASE_VERIFY_SSL=false
# Optional: Path to custom CA bundle for enterprise environments (e.g., corporate proxy certificates)
# FIREBASE_CA_BUNDLE=/path/to/enterprise-ca-bundle.pem

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Comma-separated browser origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
